# Copy to .env.local for local development.
#
# Local dev against `npm run dev` on a physical Android device: use
# `adb reverse tcp:3000 tcp:3000` and point this at localhost — NOT the LAN IP.
# Google OAuth rejects private-IP redirect URIs, so a LAN IP can't be
# registered as a callback; `adb reverse` makes the device see localhost,
# which is already registered for web dev.
EXPO_PUBLIC_API_URL=http://localhost:3000
