# Local dev secrets — copy this to `.dev.vars` and fill in your values.
# The `.dev.vars` file is gitignored and must never be committed.

# --- Turso (required) --------------------------------------------------------
# Create a database at https://turso.tech, then run:
#   turso db show <db-name>          → DATABASE_URL
#   turso db tokens create <db-name> → AUTH_TOKEN
TURSO_DATABASE_URL=libsql://<your-db-name>.<region>.turso.io
TURSO_AUTH_TOKEN=<your-turso-auth-token>

# --- Better Auth (required) --------------------------------------------------
# Generate a secret: openssl rand -base64 32
# URL must match the server origin exactly (no trailing slash).
BETTER_AUTH_SECRET=<at-least-32-char-random-string>
BETTER_AUTH_URL=http://localhost:8080

# --- Google OAuth (required) -------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorised redirect URI: http://localhost:8080/api/auth/callback/google
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# --- Resend (email verification) ---------------------------------------------
# Sign up at https://resend.com → API Keys → Create API key
# For local dev you can use the test address: onboarding@resend.dev (no domain needed)
# In production, verify your domain and set EMAIL_FROM to your own address.
RESEND_API_KEY=re_<your-resend-api-key>
EMAIL_FROM=StockTracker <stocktracker@derekyuan.co.uk>

# --- Optional features -------------------------------------------------------
# AI insights (Claude SDK)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# GitHub OAuth (leave blank if not using)
# Create at https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:8080/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Microsoft OAuth (leave blank if not using)
# Create at https://portal.azure.com → App registrations → New registration
# Redirect URI: http://localhost:8080/api/auth/callback/microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Apple OAuth (leave blank if not using)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Firebase (push notifications, leave blank if not using)
# FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Cron job auth token (generate any random string)
# CRON_SECRET=
